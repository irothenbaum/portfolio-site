{% extends "../portfolio.twig" %}

{% block styles %}
    {{ parent() }}
    <link rel="stylesheet" href="./styles/resume.css"/>
{% endblock %}

{% block content %}
    {% embed '../components/breadcrumbs.twig' with {crumbs: ['about', 'resume.html']} %}{% endembed %}
    <div id="resume-container">
        <h1>Isaac Rothenbaum</h1>
        <h2>Overview</h2>
        <p>
            I'm a pragmatic engineer with a proven track record of building successful web and mobile applications.
            I currently work full time at RXR Realty's Digital Lab, but I'm always looking for fun and challenging
            side projects to keep my skills sharp.
        </p>

        <section class="experience">
            <h2>Work Experience</h2>

            <div class="entry">
                <h4>RXR Realty</h4>
                <p class="title">Sr. Software Engineer</p>
                <p class="date">2020 - Present</p>
                <p class="description">
                    Working in RXR's Digital Lab, I'm responsible for building and maintaining a variety of
                    web and mobile applications used both internally and externally. I manage a small team of engineers,
                    but I'm still very hands-on with the code. Under my leadership, the lab has successfully deployed
                    half a dozen products, with another dozen at various stages of internal development.
                </p>
            </div>

            <div class="entry">
                <h4>Angelus</h4>
                <p class="title">CoFounder & CTO</p>
                <p class="date">2019 - 2021</p>
                <p class="description">

                </p>
            </div>
        </section>

        <section class="projects">
            <h2>Notable Projects</h2>

            <div class="entry">

            </div>
        </section>

        <section class="education">
            <h2>Education</h2>

            <div class="entry">
                <h4>Carnegie Mellon</h4>
                <p class="degree">MS - IT Software Engineering</p>
                <p class="date">2012</p>
            </div>

            <div class="entry">
                <h4>Carthage College</h4>
                <p class="degree">BA double major in Computer Science and Graphic Design</p>
                <p class="date">2011</p>
            </div>
        </section>
    </div>
{% endblock %}
